# Template for .env; every line left commented keeps its default. Each value shown is the default, or an example where there is none.
# Local development needs none of these; the npm scripts load .env when it exists.

# Required for Docker (docker compose): the domain the site is served on. Caddy gets the HTTPS certificate for it, and the
# site's address and news WebSocket are built from it.
# SITE_DOMAIN=example.com

# Docker caps on CPUs and memory for the website and the worker (ceilings, not reservations; CPUs at most the server's).
# The defaults suit a small server. On a server for this site alone, e.g. 6 CPUs and 12 GB: 4, 6g, 2 and 3g.
# WEB_CPUS=2
# WEB_MEMORY=1g
# WORKER_CPUS=1
# WORKER_MEMORY=1g

# Required for a production build without Docker (npm run build): the site's public origin and the public news WebSocket.
# SITE_URL=https://example.com
# NEWS_EVENTS_URL=wss://example.com/news-events

# Optional API keys: they raise the free rate limits; .env is git-ignored, so they stay out of the repository.
# COINGECKO_API_KEY=
# FASTNEAR_API_KEY=
# NEARBLOCKS_API_KEY=

# NEAR Intents Explorer API partner key (a JWT, free at partners.near-intents.org); without it the worker does not read swaps by referral.
# NEAR_INTENTS_EXPLORER_API_KEY=

# Database file shared by the website and the worker.
# DATABASE_PATH=data/dashboard.db

# Folder for the worker's daily database copies (beside the database by default; Docker mounts its own volume).
# BACKUP_DIR=data/backups

# Python with curl_cffi that runs the Dune reader (python3, or python on Windows, by default).
# DUNE_PYTHON=python3

# Chrome, Edge or Chromium that prints THESIS.pdf, when it is not installed in its usual place.
# CHROME_PATH=/usr/bin/google-chrome

# Address and port the worker's news WebSocket listens on.
# NEWS_EVENTS_HOST=127.0.0.1
# NEWS_EVENTS_PORT=8081

# Upstream addresses, only to point the worker at another endpoint.
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# DEFILLAMA_BASE_URL=https://api.llama.fi
# DEFILLAMA_STABLECOINS_URL=https://stablecoins.llama.fi
# DEFILLAMA_COINS_URL=https://coins.llama.fi
# NEAR_RPC_URL=https://free.rpc.fastnear.com
# NEAR_TESTNET_RPC_URL=https://rpc.testnet.fastnear.com
# Archival node for epoch block headers; a provider URL with its key in it is used for requests and never shown.
# Set its rate limit in calls a minute, a little under the provider's: 55 suits FastNEAR's free node; e.g. 720 for one allowing 15 a second.
# NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.mainnet.fastnear.com
# NEAR_ARCHIVAL_RPC_RATE_PER_MINUTE=55
# NEARBLOCKS_BASE_URL=https://api.nearblocks.io/v1
# NEARBLOCKS_V3_BASE_URL=https://api.nearblocks.io/v3
